# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000
APP_NAME="One For All Coaching"
APP_URL=http://localhost:3000

# =============================================================================
# DIRECTUS CMS CONFIGURATION
# =============================================================================
# Directus Admin Configuration
DIRECTUS_URL=http://localhost:8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# Directus Security
KEY=your_super_secret_key_here_min_32_chars
SECRET=your_secret_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database Client (pg, mysql, sqlite3, mssql)
DB_CLIENT=pg

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=your_db_password_here

# SSL Configuration (for production)
DB_SSL=false
PGSSLMODE=prefer

# =============================================================================
# CLOUD DATABASE (PRODUCTION)
# =============================================================================
# Example for Neon, PlanetScale, or other cloud providers
# PROD_DB_HOST=your-cloud-db-host
# PROD_DB_PORT=5432
# PROD_DB_DATABASE=your_db_name
# PROD_DB_USER=your_db_user
# PROD_DB_PASSWORD=your_secure_db_password
# PROD_PGSSLMODE=require

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_FROM=noreply@yourapp.com
EMAIL_TRANSPORT=smtp

# SMTP Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password

# =============================================================================
# FILE STORAGE
# =============================================================================
STORAGE_LOCATIONS=local
# For cloud storage, uncomment and configure:
# STORAGE_S3_DRIVER=s3
# STORAGE_S3_KEY=your_s3_access_key
# STORAGE_S3_SECRET=your_s3_secret_key
# STORAGE_S3_BUCKET=your_bucket_name
# STORAGE_S3_REGION=us-east-1

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# API KEYS & EXTERNAL SERVICES
# =============================================================================
# Add any external API keys here
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# SENDGRID_API_KEY=SG...

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS Origins (comma-separated)
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

# Session Security
REFRESH_TOKEN_TTL=7d
ACCESS_TOKEN_TTL=15m

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Enable debug logging
LOG_LEVEL=info
DEBUG=false

# Hot reload settings
VITE_HMR_PORT=5173
VITE_API_URL=http://localhost:8055

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Render.com specific
# RENDER=true

# Vercel specific
# VERCEL=true
# VERCEL_URL=your-app.vercel.app

# Docker settings
# DOCKER=true
# DOCKER_HOST=unix:///var/run/docker.sock